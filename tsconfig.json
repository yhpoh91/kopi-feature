{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".build",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", ".build", ".serverless"]
}
